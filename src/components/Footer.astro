---
import { business } from '../config/business';
import type { FooterSection, SiteSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  footer?: FooterSection;
  site?: SiteSection;
}

const {
  footer = BRISBANE_CCTV_FALLBACK.footer,
  site = BRISBANE_CCTV_FALLBACK.site,
} = Astro.props;

const phone = site?.phone || business.phone;
const phoneHref = site?.phoneHref || business.phoneHref;
const email = site?.email || business.email;
const abn = site?.abn || business.abn;
const aboutText = footer?.aboutText || BRISBANE_CCTV_FALLBACK.footer.aboutText;
const hoursText = footer?.hoursText || BRISBANE_CCTV_FALLBACK.footer.hoursText;
const coverageText = footer?.coverageText || BRISBANE_CCTV_FALLBACK.footer.coverageText;
const copyright = footer?.copyright || BRISBANE_CCTV_FALLBACK.footer.copyright;
---

<footer class="bg-slate-950 text-white border-t border-white/10 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

      <!-- Col 1: About & Phone -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-red-600 to-red-700 flex items-center justify-center text-white font-black text-lg">
            R
          </div>
          <span class="font-black text-lg text-white font-display">REBOOT</span>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed">
          {aboutText}
        </p>
        <div class="pt-2">
          <a href={phoneHref} class="inline-flex items-center gap-2 text-sm font-bold text-red-400 hover:text-red-300">
            <span>📞 {phone}</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Services Links -->
      <div class="space-y-3">
        <h3 class="text-sm font-black uppercase tracking-wider text-slate-300 font-display">Security Services</h3>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="#services" class="hover:text-white transition-colors">Residential 4K CCTV</a></li>
          <li><a href="#services" class="hover:text-white transition-colors">Commercial Video Surveillance</a></li>
          <li><a href="/data-ethernet-installation/" class="hover:text-white transition-colors">Structured Cat6 Cabling</a></li>
          <li><a href="#active-deterrence" class="hover:text-white transition-colors">Active Deterrence Systems</a></li>
          <li><a href="/services/" class="hover:text-white transition-colors">Computer &amp; Network Repairs</a></li>
        </ul>
      </div>

      <!-- Col 3: Quick Navigation -->
      <div class="space-y-3">
        <h3 class="text-sm font-black uppercase tracking-wider text-slate-300 font-display">Information &amp; Advice</h3>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="#pricing" class="hover:text-white transition-colors">Fixed-Price Packages</a></li>
          <li><a href="#comparison" class="hover:text-white transition-colors">PoE vs Wireless Systems</a></li>
          <li><a href="#projects" class="hover:text-white transition-colors">Recent Installations</a></li>
          <li><a href="#faqs" class="hover:text-white transition-colors">Frequently Asked Questions</a></li>
          <li><a href="/about/" class="hover:text-white transition-colors">About Richard &amp; Reboot</a></li>
        </ul>
      </div>

      <!-- Col 4: Hours & Service Area -->
      <div class="space-y-3">
        <h3 class="text-sm font-black uppercase tracking-wider text-slate-300 font-display">Hours &amp; Coverage</h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          {hoursText}
        </p>
        <p class="text-xs text-slate-400 leading-relaxed">
          {coverageText}
        </p>
        <div class="text-[11px] text-slate-500 pt-1">
          ABN: {abn}
        </div>
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        {copyright}
      </div>
      <div class="flex items-center gap-6">
        <a href="/contact/" class="hover:text-slate-400 transition-colors">Contact</a>
        <a href="#quote" class="text-red-400 hover:text-red-300 transition-colors font-bold">Request a Quote</a>
      </div>
    </div>

  </div>
</footer>
