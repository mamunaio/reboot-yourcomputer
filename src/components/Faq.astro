---
import type { FaqsSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  faqs?: FaqsSection;
}

const { faqs = BRISBANE_CCTV_FALLBACK.faqs } = Astro.props;
const badge = faqs?.badge || BRISBANE_CCTV_FALLBACK.faqs.badge;
const heading = faqs?.heading || BRISBANE_CCTV_FALLBACK.faqs.heading;
const subheading = faqs?.subheading || BRISBANE_CCTV_FALLBACK.faqs.subheading;
const faq1Q = faqs?.faq1Q || BRISBANE_CCTV_FALLBACK.faqs.faq1Q;
const faq1A = faqs?.faq1A || BRISBANE_CCTV_FALLBACK.faqs.faq1A;
const faq2Q = faqs?.faq2Q || BRISBANE_CCTV_FALLBACK.faqs.faq2Q;
const faq2A = faqs?.faq2A || BRISBANE_CCTV_FALLBACK.faqs.faq2A;
const faq3Q = faqs?.faq3Q || BRISBANE_CCTV_FALLBACK.faqs.faq3Q;
const faq3A = faqs?.faq3A || BRISBANE_CCTV_FALLBACK.faqs.faq3A;
const faq4Q = faqs?.faq4Q || BRISBANE_CCTV_FALLBACK.faqs.faq4Q;
const faq4A = faqs?.faq4A || BRISBANE_CCTV_FALLBACK.faqs.faq4A;
const faq5Q = faqs?.faq5Q || BRISBANE_CCTV_FALLBACK.faqs.faq5Q;
const faq5A = faqs?.faq5A || BRISBANE_CCTV_FALLBACK.faqs.faq5A;
const faq6Q = faqs?.faq6Q || BRISBANE_CCTV_FALLBACK.faqs.faq6Q;
const faq6A = faqs?.faq6A || BRISBANE_CCTV_FALLBACK.faqs.faq6A;
const faq7Q = faqs?.faq7Q || BRISBANE_CCTV_FALLBACK.faqs.faq7Q;
const faq7A = faqs?.faq7A || BRISBANE_CCTV_FALLBACK.faqs.faq7A;
const faq8Q = faqs?.faq8Q || BRISBANE_CCTV_FALLBACK.faqs.faq8Q;
const faq8A = faqs?.faq8A || BRISBANE_CCTV_FALLBACK.faqs.faq8A;
const faq9Q = faqs?.faq9Q || BRISBANE_CCTV_FALLBACK.faqs.faq9Q;
const faq9A = faqs?.faq9A || BRISBANE_CCTV_FALLBACK.faqs.faq9A;
---

<section class="py-16 lg:py-24 bg-slate-50 dark:bg-slate-900/50 border-b border-slate-200/80 dark:border-white/10" id="faqs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-300">
        <span>❓</span>
        <span>{badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white font-display">
        {heading}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">

      <!-- FAQ 1 -->
      <div class="rounded-2xl p-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 shadow-sm transition-all" id="faq-card-1">
        <button type="button" onclick="toggleFaq(1)" class="w-full flex items-center justify-between text-left font-bold text-base text-slate-900 dark:text-white cursor-pointer group">
          <span class="group-hover:text-red-600 transition-colors leading-snug">{faq1Q}</span>
          <span id="faq-icon-1" class="w-7 h-7 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-600 dark:text-red-400 flex items-center justify-center text-lg font-mono ml-3 shrink-0 transition-all select-none">+</span>
        </button>
        <div id="faq-wrapper-1" class="hidden pt-3 text-slate-600 dark:text-slate-300 text-sm leading-relaxed border-t border-slate-100 dark:border-white/10 mt-3">
          {faq1A}
        </div>
      </div>

      <!-- FAQ 2 -->
      <div class="rounded-2xl p-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 shadow-sm transition-all" id="faq-card-2">
        <button type="button" onclick="toggleFaq(2)" class="w-full flex items-center justify-between text-left font-bold text-base text-slate-900 dark:text-white cursor-pointer group">
          <span class="group-hover:text-red-600 transition-colors leading-snug">{faq2Q}</span>
          <span id="faq-icon-2" class="w-7 h-7 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-600 dark:text-red-400 flex items-center justify-center text-lg font-mono ml-3 shrink-0 transition-all select-none">+</span>
        </button>
        <div id="faq-wrapper-2" class="hidden pt-3 text-slate-600 dark:text-slate-300 text-sm leading-relaxed border-t border-slate-100 dark:border-white/10 mt-3">
          {faq2A}
        </div>
      </div>

      <!-- FAQ 3 -->
      <div class="rounded-2xl p-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 shadow-sm transition-all" id="faq-card-3">
        <button type="button" onclick="toggleFaq(3)" class="w-full flex items-center justify-between text-left font-bold text-base text-slate-900 dark:text-white cursor-pointer group">
          <span class="group-hover:text-red-600 transition-colors leading-snug">{faq3Q}</span>
          <span id="faq-icon-3" class="w-7 h-7 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-600 dark:text-red-400 flex items-center justify-center text-lg font-mono ml-3 shrink-0 transition-all select-none">+</span>
        </button>
        <div id="faq-wrapper-3" class="hidden pt-3 text-slate-600 dark:text-slate-300 text-sm leading-relaxed border-t border-slate-100 dark:border-white/10 mt-3">
          {faq3A}
        </div>
      </div>

      <!-- FAQ 4 -->
      <div class="rounded-2xl p-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 shadow-sm transition-all" id="faq-card-4">
        <button type="button" onclick="toggleFaq(4)" class="w-full flex items-center justify-between text-left font-bold text-base text-slate-900 dark:text-white cursor-pointer group">
          <span class="group-hover:text-red-600 transition-colors leading-snug">{faq4Q}</span>
          <span id="faq-icon-4" class="w-7 h-7 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-600 dark:text-red-400 flex items-center justify-center text-lg font-mono ml-3 shrink-0 transition-all select-none">+</span>
        </button>
        <div id="faq-wrapper-4" class="hidden pt-3 text-slate-600 dark:text-slate-300 text-sm leading-relaxed border-t border-slate-100 dark:border-white/10 mt-3">
          {faq4A}
        </div>
      </div>

      <!-- FAQ 5 -->
      <div class="rounded-2xl p-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 shadow-sm transition-all" id="faq-card-5">
        <button type="button" onclick="toggleFaq(5)" class="w-full flex items-center justify-between text-left font-bold text-base text-slate-900 dark:text-white cursor-pointer group">
          <span class="group-hover:text-red-600 transition-colors leading-snug">{faq5Q}</span>
          <span id="faq-icon-5" class="w-7 h-7 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-600 dark:text-red-400 flex items-center justify-center text-lg font-mono ml-3 shrink-0 transition-all select-none">+</span>
        </button>
        <div id="faq-wrapper-5" class="hidden pt-3 text-slate-600 dark:text-slate-300 text-sm leading-relaxed border-t border-slate-100 dark:border-white/10 mt-3">
          {faq5A}
        </div>
      </div>

      <!-- FAQ 6 -->
      <div class="rounded-2xl p-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 shadow-sm transition-all" id="faq-card-6">
        <button type="button" onclick="toggleFaq(6)" class="w-full flex items-center justify-between text-left font-bold text-base text-slate-900 dark:text-white cursor-pointer group">
          <span class="group-hover:text-red-600 transition-colors leading-snug">{faq6Q}</span>
          <span id="faq-icon-6" class="w-7 h-7 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-600 dark:text-red-400 flex items-center justify-center text-lg font-mono ml-3 shrink-0 transition-all select-none">+</span>
        </button>
        <div id="faq-wrapper-6" class="hidden pt-3 text-slate-600 dark:text-slate-300 text-sm leading-relaxed border-t border-slate-100 dark:border-white/10 mt-3">
          {faq6A}
        </div>
      </div>

      <!-- FAQ 7 -->
      <div class="rounded-2xl p-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 shadow-sm transition-all" id="faq-card-7">
        <button type="button" onclick="toggleFaq(7)" class="w-full flex items-center justify-between text-left font-bold text-base text-slate-900 dark:text-white cursor-pointer group">
          <span class="group-hover:text-red-600 transition-colors leading-snug">{faq7Q}</span>
          <span id="faq-icon-7" class="w-7 h-7 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-600 dark:text-red-400 flex items-center justify-center text-lg font-mono ml-3 shrink-0 transition-all select-none">+</span>
        </button>
        <div id="faq-wrapper-7" class="hidden pt-3 text-slate-600 dark:text-slate-300 text-sm leading-relaxed border-t border-slate-100 dark:border-white/10 mt-3">
          {faq7A}
        </div>
      </div>

      <!-- FAQ 8 -->
      <div class="rounded-2xl p-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 shadow-sm transition-all" id="faq-card-8">
        <button type="button" onclick="toggleFaq(8)" class="w-full flex items-center justify-between text-left font-bold text-base text-slate-900 dark:text-white cursor-pointer group">
          <span class="group-hover:text-red-600 transition-colors leading-snug">{faq8Q}</span>
          <span id="faq-icon-8" class="w-7 h-7 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-600 dark:text-red-400 flex items-center justify-center text-lg font-mono ml-3 shrink-0 transition-all select-none">+</span>
        </button>
        <div id="faq-wrapper-8" class="hidden pt-3 text-slate-600 dark:text-slate-300 text-sm leading-relaxed border-t border-slate-100 dark:border-white/10 mt-3">
          {faq8A}
        </div>
      </div>

      <!-- FAQ 9 -->
      <div class="rounded-2xl p-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 shadow-sm transition-all md:col-span-2" id="faq-card-9">
        <button type="button" onclick="toggleFaq(9)" class="w-full flex items-center justify-between text-left font-bold text-base text-slate-900 dark:text-white cursor-pointer group">
          <span class="group-hover:text-red-600 transition-colors leading-snug">{faq9Q}</span>
          <span id="faq-icon-9" class="w-7 h-7 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-600 dark:text-red-400 flex items-center justify-center text-lg font-mono ml-3 shrink-0 transition-all select-none">+</span>
        </button>
        <div id="faq-wrapper-9" class="hidden pt-3 text-slate-600 dark:text-slate-300 text-sm leading-relaxed border-t border-slate-100 dark:border-white/10 mt-3">
          {faq9A}
        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  function toggleFaq(index) {
    const wrapper = document.getElementById('faq-wrapper-' + index);
    const icon = document.getElementById('faq-icon-' + index);
    const card = document.getElementById('faq-card-' + index);

    if (wrapper.classList.contains('hidden')) {
      wrapper.classList.remove('hidden');
      icon.textContent = '−';
      icon.classList.add('bg-red-600', 'text-white');
      icon.classList.remove('bg-red-50', 'text-red-600');
      card.classList.add('border-red-500/50', 'shadow-md');
    } else {
      wrapper.classList.add('hidden');
      icon.textContent = '+';
      icon.classList.remove('bg-red-600', 'text-white');
      icon.classList.add('bg-red-50', 'text-red-600');
      card.classList.remove('border-red-500/50', 'shadow-md');
    }
  }
</script>
