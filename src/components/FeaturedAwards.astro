---
import type { AwardsSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  awards?: AwardsSection;
}

const { awards = BRISBANE_CCTV_FALLBACK.awards } = Astro.props;
const heading = awards?.heading || BRISBANE_CCTV_FALLBACK.awards.heading;
const ratingValue = awards?.ratingValue || BRISBANE_CCTV_FALLBACK.awards.ratingValue;
const reviewsCount = awards?.reviewsCount || BRISBANE_CCTV_FALLBACK.awards.reviewsCount;
const tagline = awards?.tagline || BRISBANE_CCTV_FALLBACK.awards.tagline;
---

<section class="py-8 bg-slate-900 border-b border-white/10 text-white" id="wom-awards">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">

      <div class="flex items-center gap-4 text-center md:text-left">
        <div class="w-12 h-12 rounded-2xl bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-2xl shrink-0">
          🏆
        </div>
        <div>
          <h3 class="text-base sm:text-lg font-black font-display text-white">{heading}</h3>
          <p class="text-xs text-slate-400 mt-0.5">{tagline}</p>
        </div>
      </div>

      <div class="flex items-center gap-6">
        <div class="flex items-center gap-2">
          <div class="flex text-amber-400 text-lg">
            ★★★★★
          </div>
          <span class="font-black text-sm text-white">{ratingValue} / 5.0</span>
          <span class="text-xs text-slate-400">({reviewsCount} Reviews)</span>
        </div>

        <a
          href="https://www.womo.com.au"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-xs font-bold text-white transition-colors"
        >
          <span>Verify WOM Reviews</span>
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>

    </div>
  </div>
</section>
