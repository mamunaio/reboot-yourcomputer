---
import { business } from '../config/business';
import type { HeroSection, SiteSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  hero?: HeroSection;
  site?: SiteSection;
}

const {
  hero = BRISBANE_CCTV_FALLBACK.hero,
  site = BRISBANE_CCTV_FALLBACK.site,
} = Astro.props;

const phone = site?.phone || business.phone;
const phoneHref = site?.phoneHref || business.phoneHref;
const badgeText = hero?.badgeText || BRISBANE_CCTV_FALLBACK.hero.badgeText;
const awardText = hero?.awardText || BRISBANE_CCTV_FALLBACK.hero.awardText;
const heading = hero?.heading || BRISBANE_CCTV_FALLBACK.hero.heading;
const description = hero?.description || BRISBANE_CCTV_FALLBACK.hero.description;
const bullet1 = hero?.bullet1 || BRISBANE_CCTV_FALLBACK.hero.bullet1;
const bullet2 = hero?.bullet2 || BRISBANE_CCTV_FALLBACK.hero.bullet2;
const bullet3 = hero?.bullet3 || BRISBANE_CCTV_FALLBACK.hero.bullet3;
const bullet4 = hero?.bullet4 || BRISBANE_CCTV_FALLBACK.hero.bullet4;
const ctaQuote = hero?.ctaQuote || BRISBANE_CCTV_FALLBACK.hero.ctaQuote;
const ctaPricing = hero?.ctaPricing || BRISBANE_CCTV_FALLBACK.hero.ctaPricing;
const imageUrl = hero?.imageUrl || BRISBANE_CCTV_FALLBACK.hero.imageUrl;
const metric1Value = hero?.metric1Value || BRISBANE_CCTV_FALLBACK.hero.metric1Value;
const metric1Label = hero?.metric1Label || BRISBANE_CCTV_FALLBACK.hero.metric1Label;
const metric2Value = hero?.metric2Value || BRISBANE_CCTV_FALLBACK.hero.metric2Value;
const metric2Label = hero?.metric2Label || BRISBANE_CCTV_FALLBACK.hero.metric2Label;
const metric3Value = hero?.metric3Value || BRISBANE_CCTV_FALLBACK.hero.metric3Value;
const metric3Label = hero?.metric3Label || BRISBANE_CCTV_FALLBACK.hero.metric3Label;
---

<section class="relative overflow-hidden pt-8 pb-16 lg:pt-14 lg:pb-24 border-b border-slate-200/80 dark:border-white/10 bg-gradient-to-b from-white via-slate-50/50 to-white dark:from-slate-900 dark:via-slate-950 dark:to-slate-900">

  <!-- Subtle Background Grid & Glows -->
  <div class="absolute inset-0 bg-light-grid pointer-events-none opacity-60"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-red-600/10 dark:bg-red-600/15 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">

      <!-- Left Column: Copy & Value Proposition -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">

        <!-- Trust Badge Pills -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-black tracking-wider uppercase bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-300 shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-red-600 animate-ping"></span>
            <span>{badgeText}</span>
          </span>

          <a href="#wom-awards" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800/60 text-amber-800 dark:text-amber-300 hover:scale-105 transition-transform shadow-2xs">
            <span>🏆</span>
            <span>{awardText}</span>
          </a>
        </div>

        <!-- H1 Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-5xl xl:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.1] font-display">
          {heading}
        </h1>

        <!-- Lead Paragraph -->
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          {description}
        </p>

        <!-- Key Bullet Points with Icons -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-left max-w-xl mx-auto lg:mx-0">
          <div class="flex items-center gap-2.5 text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200">
            <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span>{bullet1}</span>
          </div>

          <div class="flex items-center gap-2.5 text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200">
            <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span>{bullet2}</span>
          </div>

          <div class="flex items-center gap-2.5 text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200">
            <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span>{bullet3}</span>
          </div>

          <div class="flex items-center gap-2.5 text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200">
            <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span>{bullet4}</span>
          </div>
        </div>

        <!-- CTA Actions -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="#quote"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-red-600 to-red-500 hover:from-red-500 hover:to-red-600 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-red-600/25 hover:shadow-xl hover:shadow-red-600/35 transform hover:-translate-y-0.5 transition-all text-center inline-flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>{ctaQuote}</span>
          </a>

          <a
            href="#pricing"
            class="w-full sm:w-auto px-7 py-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-white/15 text-slate-800 dark:text-white hover:border-red-500 font-bold text-xs uppercase tracking-wider shadow-2xs hover:shadow-md transition-all text-center inline-flex items-center justify-center gap-2"
          >
            <span>{ctaPricing}</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
        </div>

        <!-- Micro-Metrics Strip -->
        <div class="pt-6 border-t border-slate-200/80 dark:border-white/10 grid grid-cols-3 gap-4 max-w-lg mx-auto lg:mx-0 text-center">
          <div>
            <div class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white font-display">{metric1Value}</div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400 font-semibold mt-0.5">{metric1Label}</div>
          </div>
          <div class="border-x border-slate-200 dark:border-white/10">
            <div class="text-xl sm:text-2xl font-black text-emerald-600 dark:text-emerald-400 font-display">{metric2Value}</div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400 font-semibold mt-0.5">{metric2Label}</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white font-display">{metric3Value}</div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400 font-semibold mt-0.5">{metric3Label}</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Hero Visual Showcase -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md lg:max-w-none group">

          <!-- Outer Card Container -->
          <div class="relative rounded-3xl p-2 bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-white/15 shadow-2xl shadow-slate-200/80 dark:shadow-black/70 transition-all duration-500 hover:shadow-red-600/10">

            <div class="relative rounded-2xl overflow-hidden aspect-[4/3] bg-slate-950 flex items-center justify-center">

              <!-- Hardware Image Composite -->
              <img
                src={imageUrl}
                alt="4K Dahua TiOC, Hikvision AcuSense, and Uniview Security Camera Range"
                class="w-full h-full object-cover object-center transform group-hover:scale-103 transition-transform duration-700"
                loading="eager"
              />

              <!-- Floating Status Badge -->
              <div class="absolute top-3 left-3 px-3 py-1 rounded-full bg-slate-900/85 backdrop-blur-md border border-white/20 text-white text-[11px] font-bold flex items-center gap-1.5 shadow-lg z-10">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>4K Ultra HD • Hardwired PoE</span>
              </div>

              <!-- Floating Feature Chip -->
              <div class="absolute bottom-3 inset-x-3 p-3 rounded-xl bg-slate-950/85 backdrop-blur-md border border-white/15 text-white flex items-center justify-between shadow-xl z-10">
                <div>
                  <div class="text-xs font-black tracking-tight text-white font-display">
                    Dahua TiOC • Hikvision • Uniview
                  </div>
                  <p class="text-[10px] text-slate-300">Active deterrence sirens &amp; strobe defence</p>
                </div>
                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-red-600 text-white">
                  Commercial
                </span>
              </div>

            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>
