---
import type { CaseStudiesSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  case_studies?: CaseStudiesSection;
}

const { case_studies = BRISBANE_CCTV_FALLBACK.case_studies } = Astro.props;
const badge = case_studies?.badge || BRISBANE_CCTV_FALLBACK.case_studies.badge;
const heading = case_studies?.heading || BRISBANE_CCTV_FALLBACK.case_studies.heading;
const subheading = case_studies?.subheading || BRISBANE_CCTV_FALLBACK.case_studies.subheading;
const case1Title = case_studies?.case1Title || BRISBANE_CCTV_FALLBACK.case_studies.case1Title;
const case1Suburb = case_studies?.case1Suburb || BRISBANE_CCTV_FALLBACK.case_studies.case1Suburb;
const case1Desc = case_studies?.case1Desc || BRISBANE_CCTV_FALLBACK.case_studies.case1Desc;
const case2Title = case_studies?.case2Title || BRISBANE_CCTV_FALLBACK.case_studies.case2Title;
const case2Suburb = case_studies?.case2Suburb || BRISBANE_CCTV_FALLBACK.case_studies.case2Suburb;
const case2Desc = case_studies?.case2Desc || BRISBANE_CCTV_FALLBACK.case_studies.case2Desc;
const case3Title = case_studies?.case3Title || BRISBANE_CCTV_FALLBACK.case_studies.case3Title;
const case3Suburb = case_studies?.case3Suburb || BRISBANE_CCTV_FALLBACK.case_studies.case3Suburb;
const case3Desc = case_studies?.case3Desc || BRISBANE_CCTV_FALLBACK.case_studies.case3Desc;
---

<section class="py-16 lg:py-24 bg-slate-50 dark:bg-slate-900/50 border-b border-slate-200/80 dark:border-white/10" id="projects">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/60 text-blue-700 dark:text-blue-300">
        <span>📍</span>
        <span>{badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white font-display">
        {heading}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <div class="glass-box rounded-2xl p-7 space-y-3">
        <span class="text-xs font-bold text-red-600 dark:text-red-400">{case1Suburb}</span>
        <h3 class="text-xl font-black text-slate-900 dark:text-white font-display">{case1Title}</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{case1Desc}</p>
      </div>

      <div class="glass-box rounded-2xl p-7 space-y-3">
        <span class="text-xs font-bold text-blue-600 dark:text-blue-400">{case2Suburb}</span>
        <h3 class="text-xl font-black text-slate-900 dark:text-white font-display">{case2Title}</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{case2Desc}</p>
      </div>

      <div class="glass-box rounded-2xl p-7 space-y-3">
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">{case3Suburb}</span>
        <h3 class="text-xl font-black text-slate-900 dark:text-white font-display">{case3Title}</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{case3Desc}</p>
      </div>

    </div>

  </div>
</section>
