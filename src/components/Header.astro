---
import { business } from '../config/business';
import type { SiteSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  site?: SiteSection;
}

const { site = BRISBANE_CCTV_FALLBACK.site } = Astro.props;
const phone = site?.phone || business.phone;
const phoneHref = site?.phoneHref || business.phoneHref;
---

<header class="sticky top-0 z-50 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-200/80 dark:border-white/10 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-600 to-red-700 flex items-center justify-center text-white font-black text-xl shadow-md shadow-red-600/20 group-hover:scale-105 transition-transform">
          R
        </div>
        <div class="flex flex-col">
          <span class="font-black text-xl leading-tight text-slate-900 dark:text-white font-display tracking-tight group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors">
            REBOOT
          </span>
          <span class="text-[10px] font-bold tracking-widest text-slate-500 dark:text-slate-400 uppercase">
            Computer Repairs
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="/" class="text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-red-600 dark:hover:text-red-400 transition-colors">
          Home
        </a>
        <a href="/services/" class="text-sm font-semibold text-red-600 dark:text-red-400 flex items-center gap-1.5">
          <span>Services</span>
          <span class="w-1.5 h-1.5 rounded-full bg-red-600 dark:bg-red-400"></span>
        </a>
        <a href="/about/" class="text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-red-600 dark:hover:text-red-400 transition-colors">
          About
        </a>
        <a href="/contact/" class="text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-red-600 dark:hover:text-red-400 transition-colors">
          Contact
        </a>
      </nav>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3">
        <!-- Call Button -->
        <a
          href={phoneHref}
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white text-xs font-bold uppercase tracking-wider hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
        >
          <svg class="w-4 h-4 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>{phone}</span>
        </a>

        <!-- Quote Button -->
        <a
          href="#quote"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-red-600 to-red-500 hover:from-red-500 hover:to-red-600 text-white text-xs font-black uppercase tracking-wider shadow-md shadow-red-600/25 hover:shadow-lg hover:shadow-red-600/30 transform hover:-translate-y-0.5 transition-all"
        >
          <span>Get Quote</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- Mobile Menu Toggle -->
        <button
          type="button"
          onclick="toggleMobileMenu()"
          class="md:hidden p-2 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none"
          aria-label="Toggle Navigation"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown -->
    <div id="mobile-menu" class="hidden md:hidden pb-6 pt-2 border-t border-slate-200/60 dark:border-white/10 space-y-3">
      <a href="/" class="block px-3 py-2 rounded-lg text-base font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">
        Home
      </a>
      <a href="/services/" class="block px-3 py-2 rounded-lg text-base font-semibold text-red-600 dark:text-red-400 bg-red-50/50 dark:bg-red-950/30">
        Services
      </a>
      <a href="/about/" class="block px-3 py-2 rounded-lg text-base font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">
        About
      </a>
      <a href="/contact/" class="block px-3 py-2 rounded-lg text-base font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">
        Contact
      </a>
      <div class="pt-2">
        <a href={phoneHref} class="flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-slate-100 dark:bg-slate-800 font-bold text-sm text-slate-900 dark:text-white">
          <svg class="w-4 h-4 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>{phone}</span>
        </a>
      </div>
    </div>

  </div>
</header>
