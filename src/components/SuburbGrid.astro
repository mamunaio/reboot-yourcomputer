---
import type { SuburbsSection, SiteSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  suburbs?: SuburbsSection;
  site?: SiteSection;
}

const {
  suburbs = BRISBANE_CCTV_FALLBACK.suburbs,
  site = BRISBANE_CCTV_FALLBACK.site,
} = Astro.props;

const badge = suburbs?.badge || BRISBANE_CCTV_FALLBACK.suburbs.badge;
const heading = suburbs?.heading || BRISBANE_CCTV_FALLBACK.suburbs.heading;
const intro = suburbs?.intro || BRISBANE_CCTV_FALLBACK.suburbs.intro;
function normalizeSuburbList(value: unknown): string[] {
  if (Array.isArray(value)) {
    return value.map((s) => String(s).trim()).filter(Boolean);
  }
  if (typeof value === 'string' && value.trim()) {
    return value
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
  }
  return [];
}

const innerBrisbane = normalizeSuburbList(suburbs?.innerBrisbane ?? BRISBANE_CCTV_FALLBACK.suburbs.innerBrisbane);
const southBrisbane = normalizeSuburbList(suburbs?.southBrisbane ?? BRISBANE_CCTV_FALLBACK.suburbs.southBrisbane);
const northBrisbane = normalizeSuburbList(suburbs?.northBrisbane ?? BRISBANE_CCTV_FALLBACK.suburbs.northBrisbane);
const eastBrisbane = normalizeSuburbList(suburbs?.eastBrisbane ?? BRISBANE_CCTV_FALLBACK.suburbs.eastBrisbane);
const westBrisbane = normalizeSuburbList(suburbs?.westBrisbane ?? BRISBANE_CCTV_FALLBACK.suburbs.westBrisbane);
const loganSurrounds = normalizeSuburbList(suburbs?.loganSurrounds ?? BRISBANE_CCTV_FALLBACK.suburbs.loganSurrounds);
---

<section class="py-16 lg:py-24 bg-white dark:bg-slate-900 border-b border-slate-200/80 dark:border-white/10" id="suburbs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-300">
        <span>🗺️</span>
        <span>{badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white font-display">
        {heading}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {intro}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <!-- Inner -->
      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-white/5 space-y-3">
        <h3 class="text-base font-bold text-red-600 dark:text-red-400">Brisbane Inner &amp; CBD</h3>
        <div class="flex flex-wrap gap-1.5">
          {innerBrisbane.map((suburb) => (
            <button type="button" onclick={`selectSuburbForQuote('${suburb}')`} class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 text-xs text-slate-700 dark:text-slate-300 hover:border-red-500 cursor-pointer transition-colors">
              {suburb}
            </button>
          ))}
        </div>
      </div>

      <!-- South -->
      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-white/5 space-y-3">
        <h3 class="text-base font-bold text-red-600 dark:text-red-400">Brisbane South</h3>
        <div class="flex flex-wrap gap-1.5">
          {southBrisbane.map((suburb) => (
            <button type="button" onclick={`selectSuburbForQuote('${suburb}')`} class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 text-xs text-slate-700 dark:text-slate-300 hover:border-red-500 cursor-pointer transition-colors">
              {suburb}
            </button>
          ))}
        </div>
      </div>

      <!-- North -->
      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-white/5 space-y-3">
        <h3 class="text-base font-bold text-red-600 dark:text-red-400">Brisbane North</h3>
        <div class="flex flex-wrap gap-1.5">
          {northBrisbane.map((suburb) => (
            <button type="button" onclick={`selectSuburbForQuote('${suburb}')`} class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 text-xs text-slate-700 dark:text-slate-300 hover:border-red-500 cursor-pointer transition-colors">
              {suburb}
            </button>
          ))}
        </div>
      </div>

      <!-- East -->
      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-white/5 space-y-3">
        <h3 class="text-base font-bold text-red-600 dark:text-red-400">Brisbane East &amp; Bayside</h3>
        <div class="flex flex-wrap gap-1.5">
          {eastBrisbane.map((suburb) => (
            <button type="button" onclick={`selectSuburbForQuote('${suburb}')`} class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 text-xs text-slate-700 dark:text-slate-300 hover:border-red-500 cursor-pointer transition-colors">
              {suburb}
            </button>
          ))}
        </div>
      </div>

      <!-- West -->
      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-white/5 space-y-3">
        <h3 class="text-base font-bold text-red-600 dark:text-red-400">Western Suburbs</h3>
        <div class="flex flex-wrap gap-1.5">
          {westBrisbane.map((suburb) => (
            <button type="button" onclick={`selectSuburbForQuote('${suburb}')`} class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 text-xs text-slate-700 dark:text-slate-300 hover:border-red-500 cursor-pointer transition-colors">
              {suburb}
            </button>
          ))}
        </div>
      </div>

      <!-- Logan -->
      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-white/5 space-y-3">
        <h3 class="text-base font-bold text-red-600 dark:text-red-400">Logan &amp; Surrounds</h3>
        <div class="flex flex-wrap gap-1.5">
          {loganSurrounds.map((suburb) => (
            <button type="button" onclick={`selectSuburbForQuote('${suburb}')`} class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 text-xs text-slate-700 dark:text-slate-300 hover:border-red-500 cursor-pointer transition-colors">
              {suburb}
            </button>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>
