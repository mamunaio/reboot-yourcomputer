---
import { business } from '../config/business';
import type { MobileAppSection, SiteSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  mobile_app?: MobileAppSection;
  site?: SiteSection;
}

const {
  mobile_app = BRISBANE_CCTV_FALLBACK.mobile_app,
  site = BRISBANE_CCTV_FALLBACK.site,
} = Astro.props;

const phone = site?.phone || business.phone;
const phoneHref = site?.phoneHref || business.phoneHref;
const badge = mobile_app?.badge || BRISBANE_CCTV_FALLBACK.mobile_app.badge;
const heading = mobile_app?.heading || BRISBANE_CCTV_FALLBACK.mobile_app.heading;
const subheading = mobile_app?.subheading || BRISBANE_CCTV_FALLBACK.mobile_app.subheading;
const feat1Title = mobile_app?.feat1Title || BRISBANE_CCTV_FALLBACK.mobile_app.feat1Title;
const feat1Desc = mobile_app?.feat1Desc || BRISBANE_CCTV_FALLBACK.mobile_app.feat1Desc;
const feat2Title = mobile_app?.feat2Title || BRISBANE_CCTV_FALLBACK.mobile_app.feat2Title;
const feat2Desc = mobile_app?.feat2Desc || BRISBANE_CCTV_FALLBACK.mobile_app.feat2Desc;
const feat3Title = mobile_app?.feat3Title || BRISBANE_CCTV_FALLBACK.mobile_app.feat3Title;
const feat3Desc = mobile_app?.feat3Desc || BRISBANE_CCTV_FALLBACK.mobile_app.feat3Desc;
const ctaQuote = mobile_app?.ctaQuote || BRISBANE_CCTV_FALLBACK.mobile_app.ctaQuote;
const ctaCall = mobile_app?.ctaCall || `Call ${phone}`;
---

<section class="py-16 lg:py-24 bg-white dark:bg-slate-900 border-b border-slate-200/80 dark:border-white/10" id="mobile-app">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- Left Column: Visual Phone Animation -->
      <div class="lg:col-span-5 order-last lg:order-first">
        <div class="relative mx-auto max-w-sm rounded-[2.5rem] p-3 bg-slate-900 border-4 border-slate-700 shadow-2xl">
          <div class="relative rounded-[2rem] overflow-hidden aspect-[9/16] bg-slate-950 flex flex-col justify-between p-4 text-white">
            <img
              src="/cameras-that-fight-back.gif"
              alt="Live Smartphone Security App Multi-Screen Feed Demo"
              class="absolute inset-0 w-full h-full object-cover opacity-80"
              loading="lazy"
            />
            <div class="relative z-10 flex items-center justify-between text-xs font-bold bg-slate-900/80 px-3 py-1.5 rounded-full backdrop-blur-md">
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>LIVE 4K</span>
              <span>100% Encrypted</span>
            </div>
            <div class="relative z-10 p-3 rounded-xl bg-slate-900/90 backdrop-blur-md text-xs space-y-1">
              <div class="font-bold text-red-400">Motion Alert: Driveway</div>
              <div class="text-[11px] text-slate-300">Human Detected • AI Filter Active</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Features -->
      <div class="lg:col-span-7 space-y-6">

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/60 text-blue-700 dark:text-blue-300">
          <span>📱</span>
          <span>{badge}</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white font-display">
          {heading}
        </h2>

        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          {subheading}
        </p>

        <div class="space-y-4 pt-2">

          <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-white/5">
            <div class="w-10 h-10 rounded-lg bg-blue-600/10 text-blue-600 dark:text-blue-400 flex items-center justify-center text-lg shrink-0">
              🔔
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-base">{feat1Title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-0.5 leading-relaxed">{feat1Desc}</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-white/5">
            <div class="w-10 h-10 rounded-lg bg-emerald-600/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-lg shrink-0">
              ⚡
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-base">{feat2Title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-0.5 leading-relaxed">{feat2Desc}</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-white/5">
            <div class="w-10 h-10 rounded-lg bg-purple-600/10 text-purple-600 dark:text-purple-400 flex items-center justify-center text-lg shrink-0">
              👥
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-base">{feat3Title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-0.5 leading-relaxed">{feat3Desc}</p>
            </div>
          </div>

        </div>

        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a href="#quote" class="px-7 py-3.5 rounded-xl bg-gradient-to-r from-red-600 to-red-500 text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all">
            {ctaQuote}
          </a>
          <a href={phoneHref} class="px-6 py-3.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-xs uppercase tracking-wider hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
            {ctaCall}
          </a>
        </div>

      </div>

    </div>

  </div>
</section>
