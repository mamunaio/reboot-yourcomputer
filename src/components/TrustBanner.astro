---
import type { TrustBannerSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  trust_banner?: TrustBannerSection;
}

const { trust_banner = BRISBANE_CCTV_FALLBACK.trust_banner } = Astro.props;
const badge = trust_banner?.badge || BRISBANE_CCTV_FALLBACK.trust_banner.badge;
const heading = trust_banner?.heading || BRISBANE_CCTV_FALLBACK.trust_banner.heading;
const description = trust_banner?.description || BRISBANE_CCTV_FALLBACK.trust_banner.description;
const ctaQuote = trust_banner?.ctaQuote || BRISBANE_CCTV_FALLBACK.trust_banner.ctaQuote;
const ctaPricing = trust_banner?.ctaPricing || BRISBANE_CCTV_FALLBACK.trust_banner.ctaPricing;
---

<section class="py-14 bg-gradient-to-r from-red-600 via-red-700 to-slate-900 text-white border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8 text-center lg:text-left">
      <div class="space-y-2 max-w-2xl">
        <div class="inline-block px-3 py-1 rounded-full bg-white/15 text-[11px] font-black tracking-wider uppercase backdrop-blur-md">
          {badge}
        </div>
        <h2 class="text-2xl sm:text-3xl font-black font-display leading-snug">
          {heading}
        </h2>
        <p class="text-xs sm:text-sm text-red-100/90 leading-relaxed">
          {description}
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="#quote" class="px-7 py-3.5 rounded-xl bg-white text-red-600 hover:bg-slate-100 font-black text-xs uppercase tracking-wider shadow-lg shadow-black/20 transform hover:-translate-y-0.5 transition-all">
          {ctaQuote}
        </a>
        <a href="#pricing" class="px-6 py-3.5 rounded-xl bg-red-950/60 border border-white/20 text-white hover:bg-red-950 font-bold text-xs uppercase tracking-wider transition-all">
          {ctaPricing}
        </a>
      </div>
    </div>
  </div>
</section>
