---
import { business } from '../config/business';
import type { InstallerSection, SiteSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  installer?: InstallerSection;
  site?: SiteSection;
}

const {
  installer = BRISBANE_CCTV_FALLBACK.installer,
  site = BRISBANE_CCTV_FALLBACK.site,
} = Astro.props;

const phone = site?.phone || business.phone;
const phoneHref = site?.phoneHref || business.phoneHref;
const badge = installer?.badge || BRISBANE_CCTV_FALLBACK.installer.badge;
const heading = installer?.heading || BRISBANE_CCTV_FALLBACK.installer.heading;
const name = installer?.name || BRISBANE_CCTV_FALLBACK.installer.name;
const role = installer?.role || BRISBANE_CCTV_FALLBACK.installer.role;
const bio = installer?.bio || BRISBANE_CCTV_FALLBACK.installer.bio;
const credential1 = installer?.credential1 || BRISBANE_CCTV_FALLBACK.installer.credential1;
const credential2 = installer?.credential2 || BRISBANE_CCTV_FALLBACK.installer.credential2;
const credential3 = installer?.credential3 || BRISBANE_CCTV_FALLBACK.installer.credential3;
const credential4 = installer?.credential4 || BRISBANE_CCTV_FALLBACK.installer.credential4;
const imageUrl = installer?.imageUrl || BRISBANE_CCTV_FALLBACK.installer.imageUrl;
---

<section class="py-16 lg:py-24 bg-white dark:bg-slate-900 border-b border-slate-200/80 dark:border-white/10" id="installer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="glass-box rounded-3xl p-8 lg:p-12 overflow-hidden relative">

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">

        <!-- Portrait -->
        <div class="lg:col-span-4 flex justify-center">
          <div class="relative w-56 h-56 sm:w-64 sm:h-64 rounded-3xl overflow-hidden p-2 bg-gradient-to-br from-red-600 to-amber-500 shadow-xl">
            <img
              src={imageUrl}
              alt="Richard - Licensed Lead Installer, ACMA Master Cabler"
              class="w-full h-full object-cover rounded-2xl bg-slate-900"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Bio & Credentials -->
        <div class="lg:col-span-8 space-y-5 text-center lg:text-left">

          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-300">
            <span>🛡️</span>
            <span>{badge}</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white font-display">
            {heading}
          </h2>

          <h3 class="text-xl font-bold text-red-600 dark:text-red-400">
            {name} &ndash; {role}
          </h3>

          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
            {bio}
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300">
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>{credential1}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>{credential2}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>{credential3}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>{credential4}</span>
            </div>
          </div>

          <div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-4">
            <a href="#quote" class="px-6 py-3 rounded-xl bg-gradient-to-r from-red-600 to-red-500 text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all">
              Speak with Richard
            </a>
            <a href={phoneHref} class="px-5 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-white font-bold text-xs uppercase tracking-wider hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
              Call {phone}
            </a>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
