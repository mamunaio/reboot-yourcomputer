---
import type { InclusionsSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  inclusions?: InclusionsSection;
}

const { inclusions = BRISBANE_CCTV_FALLBACK.inclusions } = Astro.props;
const badge = inclusions?.badge || BRISBANE_CCTV_FALLBACK.inclusions.badge;
const heading = inclusions?.heading || BRISBANE_CCTV_FALLBACK.inclusions.heading;
const subheading = inclusions?.subheading || BRISBANE_CCTV_FALLBACK.inclusions.subheading;
const inc1Title = inclusions?.inc1Title || BRISBANE_CCTV_FALLBACK.inclusions.inc1Title;
const inc1Desc = inclusions?.inc1Desc || BRISBANE_CCTV_FALLBACK.inclusions.inc1Desc;
const inc2Title = inclusions?.inc2Title || BRISBANE_CCTV_FALLBACK.inclusions.inc2Title;
const inc2Desc = inclusions?.inc2Desc || BRISBANE_CCTV_FALLBACK.inclusions.inc2Desc;
const inc3Title = inclusions?.inc3Title || BRISBANE_CCTV_FALLBACK.inclusions.inc3Title;
const inc3Desc = inclusions?.inc3Desc || BRISBANE_CCTV_FALLBACK.inclusions.inc3Desc;
const inc4Title = inclusions?.inc4Title || BRISBANE_CCTV_FALLBACK.inclusions.inc4Title;
const inc4Desc = inclusions?.inc4Desc || BRISBANE_CCTV_FALLBACK.inclusions.inc4Desc;
const inc5Title = inclusions?.inc5Title || BRISBANE_CCTV_FALLBACK.inclusions.inc5Title;
const inc5Desc = inclusions?.inc5Desc || BRISBANE_CCTV_FALLBACK.inclusions.inc5Desc;
const inc6Title = inclusions?.inc6Title || BRISBANE_CCTV_FALLBACK.inclusions.inc6Title;
const inc6Desc = inclusions?.inc6Desc || BRISBANE_CCTV_FALLBACK.inclusions.inc6Desc;
---

<section class="py-16 lg:py-24 bg-slate-50 dark:bg-slate-900/50 border-b border-slate-200/80 dark:border-white/10" id="inclusions">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-300">
        <span>✅</span>
        <span>{badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white font-display">
        {heading}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-white/10 shadow-sm space-y-3">
        <div class="text-2xl">📦</div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white font-display">{inc1Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{inc1Desc}</p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-white/10 shadow-sm space-y-3">
        <div class="text-2xl">🛡️</div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white font-display">{inc2Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{inc2Desc}</p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-white/10 shadow-sm space-y-3">
        <div class="text-2xl">🏠</div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white font-display">{inc3Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{inc3Desc}</p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-white/10 shadow-sm space-y-3">
        <div class="text-2xl">💾</div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white font-display">{inc4Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{inc4Desc}</p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-white/10 shadow-sm space-y-3">
        <div class="text-2xl">📱</div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white font-display">{inc5Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{inc5Desc}</p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-white/10 shadow-sm space-y-3">
        <div class="text-2xl">⭐</div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white font-display">{inc6Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{inc6Desc}</p>
      </div>

    </div>

  </div>
</section>
