---
import type { ComparisonSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  comparison?: ComparisonSection;
}

const { comparison = BRISBANE_CCTV_FALLBACK.comparison } = Astro.props;
const badge = comparison?.badge || BRISBANE_CCTV_FALLBACK.comparison.badge;
const heading = comparison?.heading || BRISBANE_CCTV_FALLBACK.comparison.heading;
const subheading = comparison?.subheading || BRISBANE_CCTV_FALLBACK.comparison.subheading;
const col1Title = comparison?.col1Title || BRISBANE_CCTV_FALLBACK.comparison.col1Title;
const col1Badge = comparison?.col1Badge || BRISBANE_CCTV_FALLBACK.comparison.col1Badge;
const col1Desc = comparison?.col1Desc || BRISBANE_CCTV_FALLBACK.comparison.col1Desc;
const col2Title = comparison?.col2Title || BRISBANE_CCTV_FALLBACK.comparison.col2Title;
const col2Badge = comparison?.col2Badge || BRISBANE_CCTV_FALLBACK.comparison.col2Badge;
const col2Desc = comparison?.col2Desc || BRISBANE_CCTV_FALLBACK.comparison.col2Desc;
const col3Title = comparison?.col3Title || BRISBANE_CCTV_FALLBACK.comparison.col3Title;
const col3Badge = comparison?.col3Badge || BRISBANE_CCTV_FALLBACK.comparison.col3Badge;
const col3Desc = comparison?.col3Desc || BRISBANE_CCTV_FALLBACK.comparison.col3Desc;
---

<section class="py-16 lg:py-24 bg-white dark:bg-slate-900 border-b border-slate-200/80 dark:border-white/10" id="comparison">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/60 text-blue-700 dark:text-blue-300">
        <span>⚖️</span>
        <span>{badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white font-display">
        {heading}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <!-- Option 1: Hardwired 4K PoE (Recommended) -->
      <div class="rounded-2xl p-7 bg-red-50/40 dark:bg-red-950/20 border-2 border-red-500 shadow-lg space-y-4 flex flex-col justify-between relative">
        <div class="space-y-3">
          <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-red-600 text-white">
            {col1Badge}
          </span>
          <h3 class="text-2xl font-black text-slate-900 dark:text-white font-display">{col1Title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{col1Desc}</p>
        </div>
      </div>

      <!-- Option 2: Wireless Battery -->
      <div class="glass-box rounded-2xl p-7 space-y-4 flex flex-col justify-between">
        <div class="space-y-3">
          <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">
            {col2Badge}
          </span>
          <h3 class="text-2xl font-black text-slate-900 dark:text-white font-display">{col2Title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{col2Desc}</p>
        </div>
      </div>

      <!-- Option 3: Analogue Retrofit -->
      <div class="glass-box rounded-2xl p-7 space-y-4 flex flex-col justify-between">
        <div class="space-y-3">
          <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-blue-100 dark:bg-blue-950/80 text-blue-700 dark:text-blue-300">
            {col3Badge}
          </span>
          <h3 class="text-2xl font-black text-slate-900 dark:text-white font-display">{col3Title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{col3Desc}</p>
        </div>
      </div>

    </div>

  </div>
</section>
