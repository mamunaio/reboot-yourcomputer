---
import { business } from '../config/business';
import type { ReviewsSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  reviews?: ReviewsSection;
}

const { reviews = BRISBANE_CCTV_FALLBACK.reviews } = Astro.props;
const badge = reviews?.badge || BRISBANE_CCTV_FALLBACK.reviews.badge;
const heading = reviews?.heading || BRISBANE_CCTV_FALLBACK.reviews.heading;
const subheading = reviews?.subheading || BRISBANE_CCTV_FALLBACK.reviews.subheading;
const rev1Author = reviews?.rev1Author || BRISBANE_CCTV_FALLBACK.reviews.rev1Author;
const rev1Suburb = reviews?.rev1Suburb || BRISBANE_CCTV_FALLBACK.reviews.rev1Suburb;
const rev1Text = reviews?.rev1Text || BRISBANE_CCTV_FALLBACK.reviews.rev1Text;
const rev2Author = reviews?.rev2Author || BRISBANE_CCTV_FALLBACK.reviews.rev2Author;
const rev2Suburb = reviews?.rev2Suburb || BRISBANE_CCTV_FALLBACK.reviews.rev2Suburb;
const rev2Text = reviews?.rev2Text || BRISBANE_CCTV_FALLBACK.reviews.rev2Text;
const rev3Author = reviews?.rev3Author || BRISBANE_CCTV_FALLBACK.reviews.rev3Author;
const rev3Suburb = reviews?.rev3Suburb || BRISBANE_CCTV_FALLBACK.reviews.rev3Suburb;
const rev3Text = reviews?.rev3Text || BRISBANE_CCTV_FALLBACK.reviews.rev3Text;
const rev4Author = reviews?.rev4Author || BRISBANE_CCTV_FALLBACK.reviews.rev4Author;
const rev4Suburb = reviews?.rev4Suburb || BRISBANE_CCTV_FALLBACK.reviews.rev4Suburb;
const rev4Text = reviews?.rev4Text || BRISBANE_CCTV_FALLBACK.reviews.rev4Text;
---

<section class="py-16 lg:py-24 bg-slate-50 dark:bg-slate-900/50 border-b border-slate-200/80 dark:border-white/10" id="reviews">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800/60 text-amber-800 dark:text-amber-300">
        <span>⭐</span>
        <span>{badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white font-display">
        {heading}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

      <!-- Review 1 -->
      <div class="glass-box rounded-2xl p-6 space-y-4 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="flex text-amber-400 text-sm">★★★★★</div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed italic">"{rev1Text}"</p>
        </div>
        <div class="pt-3 border-t border-slate-200 dark:border-white/10">
          <div class="font-bold text-sm text-slate-900 dark:text-white font-display">{rev1Author}</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400">{rev1Suburb}</div>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="glass-box rounded-2xl p-6 space-y-4 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="flex text-amber-400 text-sm">★★★★★</div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed italic">"{rev2Text}"</p>
        </div>
        <div class="pt-3 border-t border-slate-200 dark:border-white/10">
          <div class="font-bold text-sm text-slate-900 dark:text-white font-display">{rev2Author}</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400">{rev2Suburb}</div>
        </div>
      </div>

      <!-- Review 3 -->
      <div class="glass-box rounded-2xl p-6 space-y-4 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="flex text-amber-400 text-sm">★★★★★</div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed italic">"{rev3Text}"</p>
        </div>
        <div class="pt-3 border-t border-slate-200 dark:border-white/10">
          <div class="font-bold text-sm text-slate-900 dark:text-white font-display">{rev3Author}</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400">{rev3Suburb}</div>
        </div>
      </div>

      <!-- Review 4 -->
      <div class="glass-box rounded-2xl p-6 space-y-4 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="flex text-amber-400 text-sm">★★★★★</div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed italic">"{rev4Text}"</p>
        </div>
        <div class="pt-3 border-t border-slate-200 dark:border-white/10">
          <div class="font-bold text-sm text-slate-900 dark:text-white font-display">{rev4Author}</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400">{rev4Suburb}</div>
        </div>
      </div>

    </div>

  </div>
</section>
