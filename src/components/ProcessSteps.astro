---
import type { ProcessSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  process?: ProcessSection;
}

const { process = BRISBANE_CCTV_FALLBACK.process } = Astro.props;
const badge = process?.badge || BRISBANE_CCTV_FALLBACK.process.badge;
const heading = process?.heading || BRISBANE_CCTV_FALLBACK.process.heading;
const step1Title = process?.step1Title || BRISBANE_CCTV_FALLBACK.process.step1Title;
const step1Desc = process?.step1Desc || BRISBANE_CCTV_FALLBACK.process.step1Desc;
const step2Title = process?.step2Title || BRISBANE_CCTV_FALLBACK.process.step2Title;
const step2Desc = process?.step2Desc || BRISBANE_CCTV_FALLBACK.process.step2Desc;
const step3Title = process?.step3Title || BRISBANE_CCTV_FALLBACK.process.step3Title;
const step3Desc = process?.step3Desc || BRISBANE_CCTV_FALLBACK.process.step3Desc;
const step4Title = process?.step4Title || BRISBANE_CCTV_FALLBACK.process.step4Title;
const step4Desc = process?.step4Desc || BRISBANE_CCTV_FALLBACK.process.step4Desc;
---

<section class="py-16 lg:py-24 bg-white dark:bg-slate-900 border-b border-slate-200/80 dark:border-white/10" id="process">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-300">
        <span>🛠️</span>
        <span>{badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white font-display">
        {heading}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-white/5 space-y-3 relative">
        <div class="text-3xl font-black text-red-600 font-display">01</div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white font-display">{step1Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{step1Desc}</p>
      </div>

      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-white/5 space-y-3 relative">
        <div class="text-3xl font-black text-red-600 font-display">02</div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white font-display">{step2Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{step2Desc}</p>
      </div>

      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-white/5 space-y-3 relative">
        <div class="text-3xl font-black text-red-600 font-display">03</div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white font-display">{step3Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{step3Desc}</p>
      </div>

      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-white/5 space-y-3 relative">
        <div class="text-3xl font-black text-red-600 font-display">04</div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white font-display">{step4Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{step4Desc}</p>
      </div>

    </div>

  </div>
</section>
