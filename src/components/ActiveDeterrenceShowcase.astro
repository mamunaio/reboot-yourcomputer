---
import type { DeterrenceSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  deterrence?: DeterrenceSection;
}

const { deterrence = BRISBANE_CCTV_FALLBACK.deterrence } = Astro.props;
const badge = deterrence?.badge || BRISBANE_CCTV_FALLBACK.deterrence.badge;
const heading = deterrence?.heading || BRISBANE_CCTV_FALLBACK.deterrence.heading;
const subheading = deterrence?.subheading || BRISBANE_CCTV_FALLBACK.deterrence.subheading;
const description = deterrence?.description || BRISBANE_CCTV_FALLBACK.deterrence.description;
const feat1Title = deterrence?.feat1Title || BRISBANE_CCTV_FALLBACK.deterrence.feat1Title;
const feat1Desc = deterrence?.feat1Desc || BRISBANE_CCTV_FALLBACK.deterrence.feat1Desc;
const feat2Title = deterrence?.feat2Title || BRISBANE_CCTV_FALLBACK.deterrence.feat2Title;
const feat2Desc = deterrence?.feat2Desc || BRISBANE_CCTV_FALLBACK.deterrence.feat2Desc;
const feat3Title = deterrence?.feat3Title || BRISBANE_CCTV_FALLBACK.deterrence.feat3Title;
const feat3Desc = deterrence?.feat3Desc || BRISBANE_CCTV_FALLBACK.deterrence.feat3Desc;
const feat4Title = deterrence?.feat4Title || BRISBANE_CCTV_FALLBACK.deterrence.feat4Title;
const feat4Desc = deterrence?.feat4Desc || BRISBANE_CCTV_FALLBACK.deterrence.feat4Desc;
const imageUrl = deterrence?.imageUrl || BRISBANE_CCTV_FALLBACK.deterrence.imageUrl;
---

<section class="py-16 lg:py-24 bg-slate-900 text-white relative overflow-hidden" id="active-deterrence">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- Left Column: Copy & 4 Deterrence Pillars -->
      <div class="lg:col-span-7 space-y-6">

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-red-500/20 border border-red-500/30 text-red-400">
          <span>🚨</span>
          <span>{badge}</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white font-display leading-[1.1]">
          {heading}
        </h2>

        <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
          {description}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">

          <div class="p-4 rounded-xl bg-slate-800/80 border border-white/10 space-y-2">
            <div class="flex items-center gap-2 text-red-400 font-bold text-sm">
              <span>🚨</span>
              <span>{feat1Title}</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">{feat1Desc}</p>
          </div>

          <div class="p-4 rounded-xl bg-slate-800/80 border border-white/10 space-y-2">
            <div class="flex items-center gap-2 text-amber-400 font-bold text-sm">
              <span>🔊</span>
              <span>{feat2Title}</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">{feat2Desc}</p>
          </div>

          <div class="p-4 rounded-xl bg-slate-800/80 border border-white/10 space-y-2">
            <div class="flex items-center gap-2 text-blue-400 font-bold text-sm">
              <span>🧠</span>
              <span>{feat3Title}</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">{feat3Desc}</p>
          </div>

          <div class="p-4 rounded-xl bg-slate-800/80 border border-white/10 space-y-2">
            <div class="flex items-center gap-2 text-emerald-400 font-bold text-sm">
              <span>🎙️</span>
              <span>{feat4Title}</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">{feat4Desc}</p>
          </div>

        </div>

      </div>

      <!-- Right Column: Visual TiOC Turret Graphic -->
      <div class="lg:col-span-5">
        <div class="relative rounded-3xl p-3 bg-slate-800 border border-white/15 shadow-2xl overflow-hidden">
          <img
            src={imageUrl}
            alt="Dahua TiOC Active Deterrence Security Camera with Police Lights & Siren"
            class="w-full h-auto rounded-2xl object-cover"
            loading="lazy"
          />
          <div class="absolute bottom-6 inset-x-6 p-4 rounded-xl bg-slate-950/85 backdrop-blur-md border border-white/10 text-white text-center">
            <div class="text-xs font-black uppercase tracking-wider text-red-400">Dahua TiOC &amp; Hikvision AcuSense</div>
            <div class="text-sm font-bold mt-0.5">{subheading}</div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
