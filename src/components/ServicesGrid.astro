---
import type { ServicesSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  services?: ServicesSection;
}

const { services = BRISBANE_CCTV_FALLBACK.services } = Astro.props;
const heading = services?.heading || BRISBANE_CCTV_FALLBACK.services.heading;
const intro = services?.intro || BRISBANE_CCTV_FALLBACK.services.intro;
const card1Title = services?.card1Title || BRISBANE_CCTV_FALLBACK.services.card1Title;
const card1Desc = services?.card1Desc || BRISBANE_CCTV_FALLBACK.services.card1Desc;
const card2Title = services?.card2Title || BRISBANE_CCTV_FALLBACK.services.card2Title;
const card2Desc = services?.card2Desc || BRISBANE_CCTV_FALLBACK.services.card2Desc;
const card3Title = services?.card3Title || BRISBANE_CCTV_FALLBACK.services.card3Title;
const card3Desc = services?.card3Desc || BRISBANE_CCTV_FALLBACK.services.card3Desc;
const card4Title = services?.card4Title || BRISBANE_CCTV_FALLBACK.services.card4Title;
const card4Desc = services?.card4Desc || BRISBANE_CCTV_FALLBACK.services.card4Desc;
const card5Title = services?.card5Title || BRISBANE_CCTV_FALLBACK.services.card5Title;
const card5Desc = services?.card5Desc || BRISBANE_CCTV_FALLBACK.services.card5Desc;
const card6Title = services?.card6Title || BRISBANE_CCTV_FALLBACK.services.card6Title;
const card6Desc = services?.card6Desc || BRISBANE_CCTV_FALLBACK.services.card6Desc;
---

<section class="py-16 lg:py-24 bg-white dark:bg-slate-900 border-b border-slate-200/80 dark:border-white/10" id="services">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-300">
        <span>🔒</span>
        <span>SECURITY & NETWORK SOLUTIONS</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white font-display">
        {heading}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {intro}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

      <!-- Card 1 -->
      <div class="glass-box rounded-2xl p-7 flex flex-col justify-between group">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-xl bg-red-600/10 text-red-600 dark:text-red-400 flex items-center justify-center text-xl font-bold group-hover:scale-110 transition-transform">
            🏠
          </div>
          <h3 class="text-xl font-black text-slate-900 dark:text-white font-display">{card1Title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{card1Desc}</p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="glass-box rounded-2xl p-7 flex flex-col justify-between group">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-600/10 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl font-bold group-hover:scale-110 transition-transform">
            🏢
          </div>
          <h3 class="text-xl font-black text-slate-900 dark:text-white font-display">{card2Title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{card2Desc}</p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="glass-box rounded-2xl p-7 flex flex-col justify-between group">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-xl bg-purple-600/10 text-purple-600 dark:text-purple-400 flex items-center justify-center text-xl font-bold group-hover:scale-110 transition-transform">
            🛡️
          </div>
          <h3 class="text-xl font-black text-slate-900 dark:text-white font-display">{card3Title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{card3Desc}</p>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="glass-box rounded-2xl p-7 flex flex-col justify-between group">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-600/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl font-bold group-hover:scale-110 transition-transform">
            🔌
          </div>
          <h3 class="text-xl font-black text-slate-900 dark:text-white font-display">{card4Title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{card4Desc}</p>
        </div>
      </div>

      <!-- Card 5 -->
      <div class="glass-box rounded-2xl p-7 flex flex-col justify-between group">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-xl bg-red-600/10 text-red-600 dark:text-red-400 flex items-center justify-center text-xl font-bold group-hover:scale-110 transition-transform">
            🚨
          </div>
          <h3 class="text-xl font-black text-slate-900 dark:text-white font-display">{card5Title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{card5Desc}</p>
        </div>
      </div>

      <!-- Card 6 -->
      <div class="glass-box rounded-2xl p-7 flex flex-col justify-between group">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-xl bg-amber-600/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl font-bold group-hover:scale-110 transition-transform">
            🔧
          </div>
          <h3 class="text-xl font-black text-slate-900 dark:text-white font-display">{card6Title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{card6Desc}</p>
        </div>
      </div>

    </div>
  </div>
</section>
