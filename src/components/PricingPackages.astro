---
import type { PricingSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  pricing?: PricingSection;
}

const { pricing = BRISBANE_CCTV_FALLBACK.pricing } = Astro.props;
const badge = pricing?.badge || BRISBANE_CCTV_FALLBACK.pricing.badge;
const heading = pricing?.heading || BRISBANE_CCTV_FALLBACK.pricing.heading;
const intro = pricing?.intro || BRISBANE_CCTV_FALLBACK.pricing.intro;
const tier1Name = pricing?.tier1Name || BRISBANE_CCTV_FALLBACK.pricing.tier1Name;
const tier1Price = pricing?.tier1Price || BRISBANE_CCTV_FALLBACK.pricing.tier1Price;
const tier1Desc = pricing?.tier1Desc || BRISBANE_CCTV_FALLBACK.pricing.tier1Desc;
const tier2Name = pricing?.tier2Name || BRISBANE_CCTV_FALLBACK.pricing.tier2Name;
const tier2Price = pricing?.tier2Price || BRISBANE_CCTV_FALLBACK.pricing.tier2Price;
const tier2Badge = pricing?.tier2Badge || BRISBANE_CCTV_FALLBACK.pricing.tier2Badge;
const tier2Desc = pricing?.tier2Desc || BRISBANE_CCTV_FALLBACK.pricing.tier2Desc;
const tier3Name = pricing?.tier3Name || BRISBANE_CCTV_FALLBACK.pricing.tier3Name;
const tier3Price = pricing?.tier3Price || BRISBANE_CCTV_FALLBACK.pricing.tier3Price;
const tier3Badge = pricing?.tier3Badge || BRISBANE_CCTV_FALLBACK.pricing.tier3Badge;
const tier3Desc = pricing?.tier3Desc || BRISBANE_CCTV_FALLBACK.pricing.tier3Desc;
---

<section class="py-16 lg:py-24 bg-slate-50 dark:bg-slate-900/50 border-b border-slate-200/80 dark:border-white/10" id="pricing">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/60 text-emerald-700 dark:text-emerald-300">
        <span>💰</span>
        <span>{badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white font-display">
        {heading}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {intro}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">

      <!-- Tier 1: BYO -->
      <div class="glass-box rounded-2xl p-8 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Custom Option</div>
          <h3 class="text-2xl font-black text-slate-900 dark:text-white font-display">{tier1Name}</h3>
          <div class="text-3xl font-black text-slate-900 dark:text-white">{tier1Price}</div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{tier1Desc}</p>
        </div>
        <a href="#quote" class="w-full py-3.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-bold text-xs uppercase tracking-wider text-center transition-colors">
          Get BYO Quote
        </a>
      </div>

      <!-- Tier 2: 4-Camera 4K PoE (Most Popular) -->
      <div class="rounded-3xl p-8 bg-white dark:bg-slate-800 border-2 border-red-600 shadow-xl flex flex-col justify-between space-y-6 relative transform lg:-translate-y-2">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-red-600 text-white font-black text-[10px] uppercase tracking-wider shadow-md">
          {tier2Badge}
        </div>
        <div class="space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-red-600 dark:text-red-400">Turnkey Complete</div>
          <h3 class="text-2xl font-black text-slate-900 dark:text-white font-display">{tier2Name}</h3>
          <div class="text-4xl font-black text-red-600 dark:text-red-500">{tier2Price}</div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{tier2Desc}</p>
        </div>
        <a href="#quote" class="w-full py-4 rounded-xl bg-gradient-to-r from-red-600 to-red-500 text-white font-black text-xs uppercase tracking-wider text-center shadow-lg shadow-red-600/25 hover:shadow-xl transition-all">
          Order 4-Camera System
        </a>
      </div>

      <!-- Tier 3: Active Deterrence Pro -->
      <div class="glass-box rounded-2xl p-8 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400">{tier3Badge}</div>
          <h3 class="text-2xl font-black text-slate-900 dark:text-white font-display">{tier3Name}</h3>
          <div class="text-3xl font-black text-slate-900 dark:text-white">{tier3Price}</div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{tier3Desc}</p>
        </div>
        <a href="#quote" class="w-full py-3.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 font-bold text-xs uppercase tracking-wider text-center transition-colors">
          Order Active Pro
        </a>
      </div>

    </div>

  </div>
</section>
