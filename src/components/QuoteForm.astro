---
import { business } from '../config/business';
import type { QuoteFormSection, SiteSection } from '../lib/content-schema';
import { BRISBANE_CCTV_FALLBACK } from '../data/cctv-brisbane-fallback';

interface Props {
  quote_form?: QuoteFormSection;
  site?: SiteSection;
}

const {
  quote_form = BRISBANE_CCTV_FALLBACK.quote_form,
  site = BRISBANE_CCTV_FALLBACK.site,
} = Astro.props;

const phone = site?.phone || business.phone;
const badge = quote_form?.badge || BRISBANE_CCTV_FALLBACK.quote_form.badge;
const heading = quote_form?.heading || BRISBANE_CCTV_FALLBACK.quote_form.heading;
const subheading = quote_form?.subheading || BRISBANE_CCTV_FALLBACK.quote_form.subheading;
const ctaButtonText = quote_form?.ctaButtonText || BRISBANE_CCTV_FALLBACK.quote_form.ctaButtonText;
const successHeading = quote_form?.successHeading || BRISBANE_CCTV_FALLBACK.quote_form.successHeading;
const successBody = quote_form?.successBody || BRISBANE_CCTV_FALLBACK.quote_form.successBody;
---

<section class="py-16 lg:py-24 bg-white dark:bg-slate-900 border-b border-slate-200/80 dark:border-white/10" id="quote">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="glass-box rounded-3xl p-8 sm:p-12 shadow-2xl relative overflow-hidden">

      <div class="text-center max-w-2xl mx-auto mb-10 space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-300">
          <span>📝</span>
          <span>{badge}</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white font-display">
          {heading}
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300">
          {subheading}
        </p>
      </div>

      <!-- Success Message Container -->
      <div id="cctv-quote-success" class="hidden p-6 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-300 dark:border-emerald-800 text-center space-y-3 my-6">
        <div class="w-12 h-12 rounded-full bg-emerald-600 text-white flex items-center justify-center text-2xl mx-auto">✓</div>
        <h3 class="text-xl font-bold text-emerald-900 dark:text-emerald-200 font-display">{successHeading}</h3>
        <p class="text-sm text-emerald-800 dark:text-emerald-300 max-w-lg mx-auto leading-relaxed">
          {successBody}
        </p>
      </div>

      <!-- Error Message Container -->
      <div id="cctv-quote-error" class="hidden p-4 rounded-xl bg-red-50 dark:bg-red-950/50 border border-red-300 dark:border-red-800 text-center text-sm font-semibold text-red-700 dark:text-red-300 my-4"></div>

      <!-- Form -->
      <form id="cctv-quote-form" class="space-y-6">
        <input type="hidden" name="formType" value="cctv-quote" />
        <input type="text" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="form-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
              Full Name <span class="text-red-600">*</span>
            </label>
            <input
              type="text"
              id="form-name"
              name="name"
              required
              placeholder="e.g. John Smith"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 text-sm"
            />
          </div>

          <div>
            <label for="form-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
              Phone Number <span class="text-red-600">*</span>
            </label>
            <input
              type="tel"
              id="form-phone"
              name="phone"
              required
              placeholder="e.g. 0400 000 000"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 text-sm"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="form-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
              Email Address
            </label>
            <input
              type="email"
              id="form-email"
              name="email"
              placeholder="e.g. john@example.com"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 text-sm"
            />
          </div>

          <div>
            <label for="form-suburb" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
              Property Suburb <span class="text-red-600">*</span>
            </label>
            <input
              type="text"
              id="form-suburb"
              name="suburb"
              required
              placeholder="e.g. Brisbane City"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 text-sm"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div>
            <label for="form-service" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
              Service Required
            </label>
            <select
              id="form-service"
              name="serviceType"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-red-500 text-sm"
            >
              <option value="New Complete CCTV System">New 4K CCTV System</option>
              <option value="Active Deterrence CCTV">Active Deterrence Pro</option>
              <option value="BYO Camera Installation">BYO Camera Installation</option>
              <option value="Cat6 Data Cabling">Cat6 Data Cabling Only</option>
              <option value="CCTV Repair & Upgrade">CCTV Repair / NVR Upgrade</option>
            </select>
          </div>

          <div>
            <label for="form-property" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
              Property Type
            </label>
            <select
              id="form-property"
              name="propertyType"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-red-500 text-sm"
            >
              <option value="Residential Single Storey">Residential (Single Storey)</option>
              <option value="Residential Two Storey">Residential (Two Storey)</option>
              <option value="Commercial / Office">Commercial / Office</option>
              <option value="Warehouse / Industrial">Warehouse / Industrial</option>
            </select>
          </div>

          <div>
            <label for="form-cameras" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
              Cameras Needed
            </label>
            <select
              id="form-cameras"
              name="cameraCount"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-red-500 text-sm"
            >
              <option value="4 Cameras (Standard Home)">4 Cameras (Standard)</option>
              <option value="2-3 Cameras (Small Home)">2-3 Cameras</option>
              <option value="6-8 Cameras (Large Property)">6-8 Cameras (Large)</option>
              <option value="8+ Cameras (Commercial)">8+ Cameras (Commercial)</option>
              <option value="Unsure / Need Advice">Unsure / Need Advice</option>
            </select>
          </div>
        </div>

        <div>
          <label for="form-notes" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
            Project Notes / Specific Requirements
          </label>
          <textarea
            id="form-notes"
            name="message"
            rows="3"
            placeholder="Tell us about specific coverage areas (driveway, backyard, shed, front door), roof access, or preferred camera brands..."
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 text-sm"
          ></textarea>
        </div>

        <button
          type="submit"
          id="cctv-submit-btn"
          class="w-full py-4 rounded-xl bg-gradient-to-r from-red-600 to-red-500 hover:from-red-500 hover:to-red-600 text-white font-black text-sm uppercase tracking-wider shadow-lg shadow-red-600/25 hover:shadow-xl hover:shadow-red-600/35 transform hover:-translate-y-0.5 transition-all text-center flex items-center justify-center gap-2"
        >
          <span>{ctaButtonText}</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>

      </form>

    </div>

  </div>
</section>

<script is:inline>
  document.getElementById('cctv-quote-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('cctv-submit-btn');
    const successBox = document.getElementById('cctv-quote-success');
    const errorBox = document.getElementById('cctv-quote-error');

    btn.disabled = true;
    btn.classList.add('opacity-75', 'cursor-not-allowed');
    btn.innerText = 'Submitting Quote Request...';
    errorBox.classList.add('hidden');

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      const response = await fetch('/api/enquiry', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok && result.success) {
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
        successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        errorBox.textContent = result.message || 'Could not send your request. Please call us directly on (07) 3155 2002.';
        errorBox.classList.remove('hidden');
        btn.disabled = false;
        btn.classList.remove('opacity-75', 'cursor-not-allowed');
        btn.innerText = 'Submit Quote Request';
      }
    } catch (err) {
      errorBox.textContent = 'Network error. Please try again or call us on (07) 3155 2002.';
      errorBox.classList.remove('hidden');
      btn.disabled = false;
      btn.classList.remove('opacity-75', 'cursor-not-allowed');
      btn.innerText = 'Submit Quote Request';
    }
  });
</script>
