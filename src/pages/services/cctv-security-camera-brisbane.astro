---
import SecurityLayout from '../../layouts/SecurityLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import MasterCablerSection from '../../components/MasterCablerSection.astro';
import FeaturedAwards from '../../components/FeaturedAwards.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import ActiveDeterrenceShowcase from '../../components/ActiveDeterrenceShowcase.astro';
import MobileAppViewer from '../../components/MobileAppViewer.astro';
import Inclusions from '../../components/Inclusions.astro';
import SystemComparison from '../../components/SystemComparison.astro';
import PricingPackages from '../../components/PricingPackages.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import LocalCaseStudy from '../../components/LocalCaseStudy.astro';
import InstallerProfile from '../../components/InstallerProfile.astro';
import Reviews from '../../components/Reviews.astro';
import SuburbGrid from '../../components/SuburbGrid.astro';
import Faq from '../../components/Faq.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import WomBadges from '../../components/WomBadges.astro';
import Footer from '../../components/Footer.astro';
import { getBrisbaneCctvContent } from '../../lib/content-client';

const content = await getBrisbaneCctvContent('brisbane');
const {
  site,
  seo,
  hero,
  trust,
  cabler,
  awards,
  services,
  deterrence,
  mobile_app,
  inclusions,
  comparison,
  pricing,
  process,
  case_studies,
  installer,
  reviews,
  suburbs,
  faqs,
  quote_form,
  footer,
} = content;
---

<SecurityLayout
  title={seo.title}
  description={seo.description}
>
  <Header site={site} />
  <Hero hero={hero} site={site} />
  <TrustBadges trust={trust} />
  <MasterCablerSection cabler={cabler} site={site} />
  <FeaturedAwards awards={awards} />
  <ServicesGrid services={services} />
  <ActiveDeterrenceShowcase deterrence={deterrence} />
  <MobileAppViewer mobile_app={mobile_app} site={site} />
  <Inclusions inclusions={inclusions} />
  <SystemComparison comparison={comparison} />
  <PricingPackages pricing={pricing} />
  <ProcessSteps process={process} />
  <LocalCaseStudy case_studies={case_studies} />
  <InstallerProfile installer={installer} site={site} />
  <Reviews reviews={reviews} />
  <SuburbGrid suburbs={suburbs} site={site} />
  <Faq faqs={faqs} />
  <QuoteForm quote_form={quote_form} site={site} />
  <WomBadges awards={awards} />
  <Footer footer={footer} site={site} />
</SecurityLayout>
